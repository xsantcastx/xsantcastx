{
  "name": "The Godforge — Free Developer Tools",
  "short_name": "Godforge",
  "description": "Free browser tools for developers and designers, forged in the Eclipse. No sign-up, no installs.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#07040f",
  "theme_color": "#0a0a0f",
  "icons": [
    { "src": "assets/brand/icon-48.png",  "sizes": "48x48",   "type": "image/png" },
    { "src": "assets/brand/icon-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "assets/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
