FROM node:24-alpine
WORKDIR /app
# world-sim.generated.mjs is written by `node scripts/world-sim-build.mjs` before the build (scripts/social-deployment.md).
COPY --chown=node:node scripts/social-server.mjs scripts/social-words.mjs scripts/social-identity.mjs scripts/social-world.mjs scripts/world-sim.generated.mjs ./scripts/
USER node
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
CMD ["node", "scripts/social-server.mjs"]
