rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Owner identity ───────────────────────────────────────────────────────
    // The /admin dashboard checks this same address client-side, but that check
    // only decides what renders. This one decides what the database hands out,
    // which is the check that actually matters: editing the constant in the
    // bundle gets an attacker an empty dashboard, not somebody's email address.
    //
    // email_verified is required so that a provider which lets a user set an
    // arbitrary unverified address cannot mint a token claiming to be the owner.
    function isOwner() {
      return request.auth != null
             && request.auth.token.email == 'ogaitnas.9615@gmail.com'
             && request.auth.token.email_verified == true;
    }

    // ── Guestbook ────────────────────────────────────────────────────────────
    // Anyone can read; anyone can write (no auth required for guestbook)
    match /guestbook/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'timestamp'])
                   && request.resource.data.message is string
                   && request.resource.data.message.size() <= 1000
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 100;
      allow update, delete: if false;
    }

    // ── User catalogs ─────────────────────────────────────────────────────────
    // Only the authenticated owner can read/write their own catalogs.
    match /users/{uid}/catalogs/{catalogId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Bans ─────────────────────────────────────────────────────────────────
    // A ban is a document at `users/{uid}/meta/ban` with `banned: true`. It is
    // written only by the owner (see the /meta rule below, which carves `ban`
    // out of the player's own write grant — a player who could write it could
    // lift it) and it is enforced here, on the two collections that hold the
    // save.
    //
    // COST, STATED PLAINLY: `exists()` and `get()` inside a rule are billed as
    // document reads. This adds one read per *write* to progress and economy,
    // and the gateway batches a signed-in player's writes on a four-second
    // debounce — so an actively-playing account costs on the order of several
    // hundred extra reads an hour. That is a real number and it is the price of
    // the feature: a ban that only the client honours is not a ban, because the
    // thing a banned account does is stop honouring the client.
    //
    // It is deliberately NOT applied to `users/{uid}/meta/*`. Those two
    // documents are the device lease and the wipe tombstone — they coordinate
    // *which browser* writes, not *what* it writes, and letting a banned account
    // release its lease is strictly better than making it expire. Charging a
    // read to block them would buy nothing.
    function isBanned(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/meta/ban)
             && get(/databases/$(database)/documents/users/$(uid)/meta/ban).data.banned == true;
    }

    /** The player themselves, and not under a ban. */
    function isLivePlayer(uid) {
      return request.auth != null && request.auth.uid == uid && !isBanned(uid);
    }

    // ── Cloud save: progression ───────────────────────────────────────────────
    // The Godforge save, synced across a visitor's devices. Owner-only, and
    // nobody else's business — there is no leaderboard reading these.
    //
    // The `state` document holds lifetime XP and gets one extra condition:
    // XP may never go down. That is not an anti-cheat measure — the client
    // computes XP, so anyone determined to inflate it can, and the honest place
    // to stop that is a Cloud Function awarding it instead. What it does stop is
    // the failure this feature could realistically cause on its own: a second
    // device that has fallen behind writing its smaller total over a larger one
    // and silently deleting progress. The client treats the rejection as a
    // signal to re-merge rather than an error to swallow, so the case resolves
    // itself instead of surfacing as a wipe.
    //
    // Deletes are allowed: a visitor wiping their own save is a real thing to
    // want, and `XpService.reset()` is how they do it.
    //
    // The owner is granted full access on top of the player's own, and that
    // grant sits *before* the monotonic-XP condition rather than inside it. The
    // GM console's "Reset Stats" writes xp: 0 over a live total, which is
    // exactly the write the monotonic rule exists to refuse — and it should
    // refuse it, from a second device. From the console it is the entire point.
    // The two are told apart by identity, which is the only thing a rule can
    // tell them apart by.
    match /users/{uid}/progress/{docId} {
      allow read, write: if isOwner();
      // Reading stays unconditional for the player: a banned client still has to
      // load enough of itself to render the ban notice, and refusing the read
      // would show them a broken game rather than the reason they are seeing it.
      // Deleting does not — a wipe by a banned account would destroy the save
      // the console is holding it to account for. Delete is rare, so the extra
      // rule read it costs is not the recurring charge the write path's is.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if isLivePlayer(uid);
      allow create: if isLivePlayer(uid);
      allow update: if isLivePlayer(uid)
                    && (
                      docId != 'state'
                      || !('xp' in resource.data)
                      || !('xp' in request.resource.data)
                      || request.resource.data.xp >= resource.data.xp
                    );
    }

    // ── Cloud save: the Godforge ledger ───────────────────────────────────────
    // Gold and Eclipse Essence are spendable, so nothing here is monotonic —
    // the whole point of a currency is that it goes down. Owner-only is the
    // entire rule, deliberately: a stricter one would have to model every sink
    // in economy.model.ts, and would break the next time a price changed.
    match /users/{uid}/economy/{docId} {
      allow read, write: if isOwner();
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isLivePlayer(uid);
    }

    // ── Cloud save: device coordination ──────────────────────────────────────
    // Two documents, both owner-only, both about *which device* rather than
    // what the save contains:
    //
    //   meta/device-lease — who currently holds write authority. Acquired in a
    //     Firestore transaction so two devices racing for it cannot both win.
    //     Deletable, because releasing on tab close is what saves the next
    //     device from waiting out the two-minute expiry.
    //
    //   meta/reset — the wipe tombstone. `at` is a millisecond stamp and the
    //     client keeps the later of the two sides, so this must be updatable
    //     downward-in-principle: a monotonic rule here would be wrong, since a
    //     device whose clock is behind still has to be able to record a wipe
    //     the visitor genuinely took. The document is worthless to an attacker
    //     with the owner's credentials — they could delete the save directly.
    //
    // Deliberately not merged into the /progress rule above: that one carries
    // the monotonic-XP condition, and neither of these has an `xp` field, so
    // they would sit in it only to be exempted from its single reason to exist.
    //
    //   meta/ban — the GM console's tombstone. Carved out of the player's own
    //     write grant below, and that carve-out is the whole security model of
    //     the ban: `isBanned()` reads this document to decide whether a save
    //     may be written, so a player who could write it could lift their own
    //     ban in one console call. They may *read* it, because their client has
    //     to render the reason.
    match /users/{uid}/meta/{docId} {
      allow read, write: if isOwner();
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && docId != 'ban';
    }

    // ── The player directory ─────────────────────────────────────────────────
    // One denormalised summary row per player, so the GM console has something
    // to enumerate. See the header of shared/cloud-save/gm.model.ts for why this
    // has to exist at all: a client cannot list subcollections, `users/{uid}` is
    // a path prefix with no document at it, and there is therefore no query that
    // answers "who plays this".
    //
    // A player writes only their own row, and the schema below is the reason
    // this is safe to let them write. Every field is typed and bounded, so the
    // worst a hostile client can do is lie about its own Gold — and it could
    // already do that by writing its own ledger. Nothing here is trusted for
    // anything but sorting a table; the console re-reads the real documents
    // before it shows or changes a number.
    //
    // `uid` is pinned to the document id so a row cannot impersonate another
    // player in the table, which is the one lie that would actually matter.
    match /player-directory/{uid} {
      allow read, delete: if isOwner();
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly([
                         'uid', 'email', 'displayName', 'rank',
                         'level', 'gold', 'totalXp', 'lastActive', 'createdAt'
                       ])
                    && request.resource.data.uid == uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 120
                    && request.resource.data.rank is string
                    && request.resource.data.rank.size() <= 60
                    && request.resource.data.level is number
                    && request.resource.data.gold is number
                    && request.resource.data.totalXp is number
                    && request.resource.data.lastActive is number
                    && request.resource.data.createdAt is number;
    }

    // ── Ban index ────────────────────────────────────────────────────────────
    // The same BanRecord as `users/{uid}/meta/ban`, in a flat owner-only
    // collection. Two copies of one fact is a thing to justify, so:
    //
    //   `users/{uid}/meta/ban` is the ENFORCEMENT copy, and it has to live
    //   exactly there because `isBanned()` above reaches it by a path built from
    //   the incoming request. A rule cannot look a ban up by any other key.
    //
    //   `admin-bans/{uid}` is the INDEX, and it has to be flat because the
    //   console's user table needs a status column and there is no query that
    //   asks "which of these hundred uids has a ban document". Reading them one
    //   at a time would be one billed read per player per dashboard open; this
    //   collection holds only the banned, which is normally none.
    //
    // The console writes the enforcement copy first and the index second, so the
    // only state a half-failed ban can leave behind is "banned but not listed" —
    // the direction where the sanction still holds and the console under-reports
    // it, rather than the direction where the table claims a ban that is not
    // being enforced.
    match /admin-bans/{uid} {
      allow read, write: if isOwner();
    }

    // ── Admin audit trail ────────────────────────────────────────────────────
    // Every destructive action the console takes writes one of these first.
    // Owner-only in both directions, and deliberately create-only: an audit log
    // that its own author can edit is a diary, not a log. Deletes are refused
    // for the same reason — the trail is worth keeping precisely on the days
    // somebody would rather it were shorter.
    match /admin-logs/{logId} {
      allow read: if isOwner();
      allow create: if isOwner()
                    && request.resource.data.keys().hasOnly([
                         'action', 'targetUid', 'targetName',
                         'actorUid', 'actorEmail', 'detail', 'at'
                       ])
                    && request.resource.data.action is string
                    && request.resource.data.detail is string
                    && request.resource.data.detail.size() <= 500
                    && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // ── Site-wide notice ─────────────────────────────────────────────────────
    // The broadcast banner and the maintenance flag, in one document because a
    // client that reads either has already paid for both. Publicly readable —
    // that is the entire point of a broadcast — and owner-write only.
    match /site-config/{docId} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.data.message is string
                   && request.resource.data.message.size() <= 400
                   && request.resource.data.maintenance is bool;
    }

    // ── Live Activity Feed ────────────────────────────────────────────────────
    // Written by the Claude Code PostToolUse hook; read by the /live page.
    match /claude-activity/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['type', 'text', 'timestamp'])
                   && request.resource.data.type in ['tool_call', 'thinking', 'success', 'error', 'system', 'output']
                   && request.resource.data.text is string
                   && request.resource.data.text.size() <= 300;
      allow delete: if false; // pruning handled by Cloud Function (Admin SDK)
      allow update: if false;
    }

    // ── Live Viewer Presence ──────────────────────────────────────────────────
    match /live-viewers/{sessionId} {
      allow read:   if true;
      allow create, update: if request.resource.data.keys().hasAll(['sessionId', 'timestamp']);
      allow delete: if true;
    }

    // ── Live Chat ─────────────────────────────────────────────────────────────
    match /live-chat/{msgId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'timestamp'])
                   && request.resource.data.message is string
                   && request.resource.data.message.size() <= 200
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 20;
      allow update, delete: if false;
    }

    // ── Bot Agent Chat ────────────────────────────────────────────────────────
    match /bot-chat/{msgId} {
      allow read:   if true;
      allow create: if request.resource.data.keys().hasAll(['botName', 'message', 'timestamp'])
                   && request.resource.data.message is string
                   && request.resource.data.message.size() <= 500
                   && request.resource.data.botName is string
                   && request.resource.data.botName.size() <= 50;
      allow update, delete: if false;
    }

    // ── Changelog ────────────────────────────────────────────────────────────
    match /changelog/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Homepage newsletter subscribers ──────────────────────────────────────
    // Anyone can subscribe (create-only). No one can read or modify entries
    // from the client — the email list is only readable via the Admin SDK
    // (Cloud Function consumers / backend exporters).
    match /homepage_subscribers/{subId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.subscribedAt is string
                    && request.resource.data.subscribedAt.size() <= 40
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 100;
      allow update, delete: if false;
    }

    // ── Blueprint tool suggestions ───────────────────────────────────────────
    // The /blueprint page lets anyone suggest a tool (create-only). Nothing is
    // client-readable — suggestions are triaged with the Admin SDK. `email` is
    // optional from the user's point of view but always present as a key (the
    // client sends '' when it's blank) so hasOnly() doesn't need to branch.
    match /blueprint-suggestions/{suggestionId} {
      // Suggestions carry a submitter's email address, so the read is owner-only
      // — this is the one collection on the site holding third-party contact
      // details that was never meant to be public.
      allow read: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['name', 'description', 'email', 'submittedAt', 'source'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.description is string
                    && request.resource.data.description.size() >= 10
                    && request.resource.data.description.size() <= 1000
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && (request.resource.data.email.size() == 0
                        || request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'))
                    && request.resource.data.submittedAt is string
                    && request.resource.data.submittedAt.size() <= 40
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 100;
      // Triage from /admin. The owner may set `review` and nothing else — the
      // affectedKeys() check means this cannot be used to rewrite a submitter's
      // words or address, only to file the suggestion.
      allow update: if isOwner()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review'])
                    && request.resource.data.review in ['reviewed', 'accepted', 'rejected'];
      allow delete: if false;
    }

    // ── Easter egg discovery counters ────────────────────────────────────────
    // EasterEggService writes these as
    //   setDoc(ref, { discoveries: increment(1), name }, { merge: true })
    // so every write carries exactly those two keys.
    //
    // This collection had NO rule before the /admin dashboard needed to read it,
    // which meant it fell through to the deny-all at the bottom of this file:
    // every discovery write since the egg system shipped was rejected and the
    // counts have been stuck at nothing. The service swallows the error, so it
    // never surfaced. Adding the rule is what actually turns the counters on.
    match /easter-eggs/{eggId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['discoveries', 'name'])
                    && request.resource.data.discoveries == 1
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      allow update: if request.resource.data.keys().hasOnly(['discoveries', 'name'])
                    && request.resource.data.discoveries is number
                    && request.resource.data.discoveries == resource.data.discoveries + 1
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 100;
      allow delete: if false;
    }

    // ── Site stats (visit counter) ───────────────────────────────────────────
    // Anyone can read and bump the visitor count. Schema is strictly enforced:
    //   { count: number, lastVisit: string }
    // and we cap the count increment to +1 per request so a single client
    // can't griefthe counter into the stratosphere.
    match /site-stats/{statId} {
      allow read: if true;
      // Create the doc on first visit if it doesn't exist yet.
      allow create: if request.resource.data.keys().hasOnly(['count', 'lastVisit'])
                    && request.resource.data.count == 1
                    && request.resource.data.lastVisit is string
                    && request.resource.data.lastVisit.size() <= 50;
      // Increment by 1 only. lastVisit must be a string ISO timestamp.
      allow update: if request.resource.data.keys().hasOnly(['count', 'lastVisit'])
                    && request.resource.data.count is number
                    && request.resource.data.count == resource.data.count + 1
                    && request.resource.data.lastVisit is string
                    && request.resource.data.lastVisit.size() <= 50;
      allow delete: if false;
    }

    // ── Tool usage counter ───────────────────────────────────────────────────
    // Per-tool popularity counter written by ToolUsageService as
    //   setDoc(ref, { count: increment(1) }, { merge: true })
    // so each write contains ONLY { count }. Anyone may read and bump by +1.
    match /tool-usage/{toolId} {
      allow read: if true;
      // First use creates the doc with count == 1.
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      // Subsequent uses increment by exactly 1.
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is number
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
